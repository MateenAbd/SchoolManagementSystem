@{
    ViewData["Title"] = "Fee Management";
}


<p>After initiating, you’ll be redirected to /Fee/Pay?orderNo=... which opens Razorpay Checkout.</p>
<h2>Fee Management</h2>



@{
    ViewData["Title"] = "Fee Management";
    var isAdmin = User?.IsInRole("Admin") == true;
    var isTeacher = User?.IsInRole("Teacher") == true;
}
<div id="feePage" class="row">
    <div class="col-12 d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Fees</h2>
        <div id="feeGlobalMsg" class="d-none"></div>
    </div>

    @if (!(isAdmin || isTeacher))
    {
        <div class="col-12">
            <div class="alert alert-warning">You do not have permission to access the Fee module.</div>
        </div>
    }
    else
    {
        <div class="col-12">
            <ul class="nav nav-tabs" id="feeTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-heads" data-bs-toggle="tab" data-bs-target="#pane-heads" type="button" role="tab">Fee Heads</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-terms" data-bs-toggle="tab" data-bs-target="#pane-terms" type="button" role="tab">Fee Terms</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-structures" data-bs-toggle="tab" data-bs-target="#pane-structures" type="button" role="tab">Fee Structures</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-demand" data-bs-toggle="tab" data-bs-target="#pane-demand" type="button" role="tab">Demand & Collection</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-receipts" data-bs-toggle="tab" data-bs-target="#pane-receipts" type="button" role="tab">Receipts & Ledger</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-rules" data-bs-toggle="tab" data-bs-target="#pane-rules" type="button" role="tab">Rules & Discounts</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-adjust" data-bs-toggle="tab" data-bs-target="#pane-adjust" type="button" role="tab">Adjustments</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-online" data-bs-toggle="tab" data-bs-target="#pane-online" type="button" role="tab">Online Payment</button>
                </li>
            </ul>

            <div class="tab-content mt-3">

                <!-- Fee Heads -->
                <div class="tab-pane fade show active" id="pane-heads" role="tabpanel" aria-labelledby="tab-heads">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div id="fhMsg" class="d-none"></div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label">Active</label>
                                    <select id="fhFilterActive" class="form-select">
                                        <option value="">Any</option>
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex gap-2">
                                    <button class="btn btn-outline-primary" id="btnLoadFeeHeads">Refresh</button>
                                    @if (isAdmin)
                                    {
                                        <button class="btn btn-primary" id="btnNewFeeHead">New Head</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped align-middle mb-0" id="fhTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:90px;">Head ID</th>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Sort</th>
                                            <th>Description</th>
                                            <th style="width:100px;">Active</th>
                                            <th style="width:200px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody><tr><td colspan="7" class="p-3 text-center text-muted">No data</td></tr></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fee Terms -->
                <div class="tab-pane fade" id="pane-terms" role="tabpanel" aria-labelledby="tab-terms">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div id="ftMsg" class="d-none"></div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label">Academic Year</label>
                                    <input type="text" id="ftFilterYear" class="form-control" placeholder="2025-26" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Active</label>
                                    <select id="ftFilterActive" class="form-select">
                                        <option value="">Any</option>
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex gap-2">
                                    <button class="btn btn-outline-primary" id="btnLoadFeeTerms">Refresh</button>
                                    @if (isAdmin)
                                    {
                                        <button class="btn btn-primary" id="btnNewFeeTerm">New Term</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped align-middle mb-0" id="ftTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:90px;">Term ID</th>
                                            <th>AY</th>
                                            <th>Code</th>
                                            <th>Name</th>
                                            <th>Seq</th>
                                            <th>Due Date</th>
                                            <th style="width:100px;">Active</th>
                                            <th style="width:220px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody><tr><td colspan="8" class="p-3 text-center text-muted">No data</td></tr></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fee Structures -->
                <div class="tab-pane fade" id="pane-structures" role="tabpanel" aria-labelledby="tab-structures">
                    <div class="row g-3">
                        <div class="col-12">
                            <div id="fsMsg" class="d-none"></div>
                        </div>

                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span>Fee Structure Headers</span>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-primary btn-sm" id="btnLoadStructures">Refresh</button>
                                        @if (isAdmin)
                                        {
                                            <button class="btn btn-primary btn-sm" id="btnNewStructure">New Structure</button>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-2">
                                            <label class="form-label">AY</label>
                                            <input type="text" id="fsFilterYear" class="form-control" placeholder="2025-26" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Class</label>
                                            <input type="text" id="fsFilterClass" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Section</label>
                                            <input type="text" id="fsFilterSection" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Term</label>
                                            <input type="number" id="fsFilterTerm" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Active</label>
                                            <select id="fsFilterActive" class="form-select">
                                                <option value="">Any</option>
                                                <option value="true">Active</option>
                                                <option value="false">Inactive</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <button class="btn btn-outline-primary w-100" id="btnSearchStructures">Search</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-striped align-middle mb-0" id="fsTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width:90px;">Structure ID</th>
                                                    <th>AY</th>
                                                    <th>Class</th>
                                                    <th>Term</th>
                                                    <th>Effective</th>
                                                    <th style="width:100px;">Active</th>
                                                    <th style="width:220px;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody><tr><td colspan="7" class="p-3 text-center text-muted">No data</td></tr></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <small class="text-muted">Create one structure per AY/Class/Term. Use details to define head-wise amounts.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                                <!-- Demand & Collection -->
                <div class="tab-pane fade" id="pane-demand" role="tabpanel" aria-labelledby="tab-demand">
                    <div class="row g-3">
                        <div class="col-12">
                            <div id="dcMsg" class="d-none"></div>
                        </div>

                        <!-- Generate Demand -->
                        <div class="col-12 col-xl-4">
                            <div class="card shadow-sm">
                                <div class="card-header">Generate Student Term Fee (Demand)</div>
                                <div class="card-body">
                                    <div id="gdMsg" class="d-none"></div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label">Student ID</label>
                                            <input type="number" id="gdStudentId" class="form-control" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Academic Year</label>
                                            <input type="text" id="gdYear" class="form-control" placeholder="2025-26" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Term ID</label>
                                            <input type="number" id="gdTerm" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer d-flex gap-2">
                                    <button class="btn btn-success" id="btnGenerateDemand">Generate Demand</button>
                                </div>
                            </div>
                        </div>

                        <!-- Collect Fee -->
                        <div class="col-12 col-xl-8">
                            <div class="card shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span>Collect Fee</span>
                                    <small class="text-muted">Add head-wise amounts and collect</small>
                                </div>
                                <div class="card-body">
                                    <div id="clMsg" class="d-none"></div>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-2">
                                            <label class="form-label">Student ID</label>
                                            <input type="number" id="clStudentId" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Academic Year</label>
                                            <input type="text" id="clYear" class="form-control" placeholder="2025-26" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Term ID</label>
                                            <input type="number" id="clTerm" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Mode</label>
                                            <select id="clMode" class="form-select">
                                                <option>Cash</option>
                                                <option>Card</option>
                                                <option>UPI</option>
                                                <option>NetBanking</option>
                                                <option>OnlineGateway</option>
                                                <option>Cheque</option>
                                                <option>DD</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Reference No</label>
                                            <input type="text" id="clRef" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Receipt Date</label>
                                            <input type="date" id="clDate" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h6 class="mb-0">Receipt Items</h6>
                                            <button class="btn btn-sm btn-primary" id="btnClAddRow">Add Row</button>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped align-middle" id="clItemsTable">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width:80px;">#</th>
                                                        <th style="width:240px;">Fee Head</th>
                                                        <th style="width:160px;">Amount</th>
                                                        <th style="width:120px;">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr><td colspan="4" class="p-3 text-center text-muted">No rows</td></tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="text-end mt-2">
                                            <strong>Total: </strong><span id="clTotal">0.00</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer d-flex gap-2">
                                    <button class="btn btn-success" id="btnCollectFee">Collect</button>
                                    <button class="btn btn-outline-secondary" id="btnClClear">Clear</button>
                                </div>
                            </div>
                        </div>

                        <!-- Current Balance -->
                        <div class="col-12">
                            <div class="alert alert-info d-flex justify-content-between">
                                <span>Student Fee Balance:</span>
                                <span id="clBalanceText">-</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Receipts & Ledger -->
                <div class="tab-pane fade" id="pane-receipts" role="tabpanel" aria-labelledby="tab-receipts">
                    <div class="row g-3">
                        <div class="col-12">
                            <div id="rcMsg" class="d-none"></div>
                        </div>

                        <!-- Receipts List -->
                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-header">Receipt List</div>
                                <div class="card-body">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-2">
                                            <label class="form-label">AY</label>
                                            <input type="text" id="rcYear" class="form-control" placeholder="2025-26" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Student ID</label>
                                            <input type="number" id="rcStudentId" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Term ID</label>
                                            <input type="number" id="rcTerm" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">From</label>
                                            <input type="date" id="rcFrom" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">To</label>
                                            <input type="date" id="rcTo" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Mode</label>
                                            <input type="text" id="rcMode" class="form-control" placeholder="Cash/UPI/..." />
                                        </div>
                                        <div class="col-md-2">
                                            <button class="btn btn-outline-primary w-100" id="btnLoadReceipts">Load</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped mb-0" id="rcTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width:100px;">Receipt ID</th>
                                                    <th>AY</th>
                                                    <th>Student</th>
                                                    <th>Term</th>
                                                    <th>Date</th>
                                                    <th>Mode</th>
                                                    <th>Amount</th>
                                                    <th style="width:150px;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody><tr><td colspan="8" class="p-3 text-center text-muted">No data</td></tr></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ledger -->
                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-header">Student Ledger</div>
                                <div class="card-body">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label">Student ID</label>
                                            <input type="number" id="lgStudentId" class="form-control" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Academic Year</label>
                                            <input type="text" id="lgYear" class="form-control" placeholder="2025-26" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Term ID (opt)</label>
                                            <input type="number" id="lgTerm" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <button class="btn btn-outline-primary w-100" id="btnLoadLedger">Load</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped mb-0" id="lgTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Type</th>
                                                    <th>Head</th>
                                                    <th>Amount</th>                                                    
                                                    <th>Balance</th>
                                                    <th>Narration</th>
                                                </tr>
                                            </thead>
                                            <tbody><tr><td colspan="7" class="p-3 text-center text-muted">No data</td></tr></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Rules & Discounts -->
                <div class="tab-pane fade" id="pane-rules" role="tabpanel" aria-labelledby="tab-rules">
                    <div class="row g-3">
                        <div class="col-12"><div id="rdMsg" class="d-none"></div></div>

                        <!-- Fine Rules -->
                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span>Fine Rules</span>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-primary btn-sm" id="btnLoadFineRules">Refresh</button>
                                        @if (isAdmin)
                                        {
                                            <button class="btn btn-primary btn-sm" id="btnNewFineRule">New Fine Rule</button>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-2">
                                            <label class="form-label">AY</label>
                                            <input type="text" id="frYear" class="form-control" placeholder="2025-26" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Class (opt)</label>
                                            <input type="text" id="frClass" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Section (opt)</label>
                                            <input type="text" id="frSection" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Term ID</label>
                                            <input type="number" id="frTerm" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Active</label>
                                            <select id="frActive" class="form-select">
                                                <option value="">Any</option>
                                                <option value="true">Active</option>
                                                <option value="false">Inactive</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <button class="btn btn-outline-primary w-100" id="btnSearchFineRules">Search</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped mb-0" id="frTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width:90px;">Rule ID</th>
                                                    <th>AY</th>
                                                    <th>Class</th>
                                                    <th>Term</th>
                                                    <th>Mode</th>
                                                    <th>Rate</th>
                                                    <th>Max</th>
                                                    <th>Head</th>
                                                    <th>Active</th>
                                                    <th style="width:180px;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody><tr><td colspan="10" class="p-3 text-center text-muted">No data</td></tr></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Discount Schemes -->
                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span>Discount Schemes</span>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-primary btn-sm" id="btnLoadSchemes">Refresh</button>
                                        @if (isAdmin)
                                        {
                                            <button class="btn btn-primary btn-sm" id="btnNewScheme">New Scheme</button>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-2">
                                            <label class="form-label">AY</label>
                                            <input type="text" id="dsYear" class="form-control" placeholder="2025-26" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Class (opt)</label>
                                            <input type="text" id="dsClass" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Section (opt)</label>
                                            <input type="text" id="dsSection" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Term ID (opt)</label>
                                            <input type="number" id="dsTerm" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Active</label>
                                            <select id="dsActive" class="form-select">
                                                <option value="">Any</option>
                                                <option value="true">Active</option>
                                                <option value="false">Inactive</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <button class="btn btn-outline-primary w-100" id="btnSearchSchemes">Search</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped mb-0" id="dsTable">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width:90px;">Scheme ID</th>
                                                    <th>Code</th>
                                                    <th>Name</th>
                                                    <th>Scope</th>
                                                    <th>Mode</th>
                                                    <th>Value</th>
                                                    <th>Cap</th>
                                                    <th>Head</th>
                                                    <th>Active</th>
                                                    <th style="width:180px;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody><tr><td colspan="10" class="p-3 text-center text-muted">No data</td></tr></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Student Scholarships -->
                        <div class="col-12">
                            <div class="card shadow-sm">
