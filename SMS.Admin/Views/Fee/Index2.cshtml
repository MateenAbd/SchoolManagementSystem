            <div class="col-md-3"><label class="form-label">Student ID</label><input type="number" id="schStudent" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">AY</label><input type="text" id="schAy" class="form-control" placeholder="2025-26" /></div>
            <div class="col-md-2"><label class="form-label">Term ID (opt)</label><input type="number" id="schTermVal" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label">Mode</label><select id="schMode" class="form-select"><option>Percent</option><option>Amount</option></select></div>
            <div class="col-md-2"><label class="form-label">Value</label><input type="number" step="0.01" id="schValue" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Cap Amount (opt)</label><input type="number" step="0.01" id="schCap" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Scholarship Head ID</label><input type="number" id="schHead" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Scheme ID (opt)</label><input type="number" id="schScheme" class="form-control" /></div>
            <div class="col-md-3"><label class="form-label">Active</label><select id="schActiveVal" class="form-select"><option value="true">Yes</option><option value="false">No</option></select></div>
        </div>
      </div>
      <div class="modal-footer d-flex gap-2">
        <button class="btn btn-success" id="btnSaveScholarship">Save</button>
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

