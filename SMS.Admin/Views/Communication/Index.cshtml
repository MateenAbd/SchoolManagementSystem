@using System.Security.Claims
@{
    ViewData["Title"] = "Communication";
    var currentUserIdStr = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0";
    int.TryParse(currentUserIdStr, out var currentUserId);
}

<style>
    .chat-app {
        display: flex;
        height: calc(100vh - 120px);
        gap: 0;
    }

    .chat-sidebar {
        width: 320px;
        min-width: 260px;
        max-width: 420px;
        border-right: 1px solid #e3e3e3;
        background: #fafafa;
        display: flex;
        flex-direction: column;
    }

        .chat-sidebar .header {
            padding: 12px 14px;
            border-bottom: 1px solid #e3e3e3;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chat-sidebar .tools {
            padding: 10px 14px;
            border-bottom: 1px solid #e3e3e3;
            display: flex;
            gap: 8px;
            align-items: center;
        }

            .chat-sidebar .tools input {
                width: 100px;
            }

        .chat-sidebar .list {
            overflow-y: auto;
        }

        .chat-sidebar .item {
            padding: 10px 14px;
            cursor: pointer;
            border-bottom: 1px solid #eee;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

            .chat-sidebar .item:hover {
                background: #f0f0f0;
            }

            .chat-sidebar .item.active {
                background: #e9f5ff;
            }

            .chat-sidebar .item .title {
                font-weight: 600;
                font-size: 14px;
                display: flex;
                gap: 6px;
                align-items: center;
            }

            .chat-sidebar .item .meta {
                font-size: 12px;
                color: #666;
            }

    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .chat-main .header {
            padding: 12px 16px;
            border-bottom: 1px solid #e3e3e3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

            .chat-main .header .left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .chat-main .header .title {
                font-weight: 700;
            }

            .chat-main .header .presence {
                font-size: 12px;
                color: #666;
                display: flex;
                align-items: center;
                gap: 6px;
            }

    .presence .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .dot.online {
        background: #28a745;
    }

    .dot.offline {
        background: #888;
    }

    .conn {
        font-size: 12px;
    }

        .conn .badge {
            padding: 2px 6px;
            border-radius: 8px;
        }

        .conn .ok {
            background: #d4edda;
            color: #155724;
        }

        .conn .warn {
            background: #fff3cd;
            color: #856404;
        }

        .conn .err {
            background: #f8d7da;
            color: #721c24;
        }

    .messages-pane {
        flex: 1;
        overflow-y: auto;
        padding: 12px 16px;
        background: #f7fafc;
    }

    .msg {
        max-width: 64%;
        margin: 4px 0;
        padding: 8px 10px;
        border-radius: 10px;
        display: inline-block;
        position: relative;
        background: white;
        border: 1px solid #eee;
    }

        .msg.mine {
            background: #dff5ff;
            align-self: flex-end;
            border-color: #c4e9fb;
        }

    .msg-wrapper {
        display: flex;
        flex-direction: column;
    }

    .msg-row {
        display: flex;
    }

        .msg-row.mine {
            justify-content: flex-end;
        }

    .msg .body {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .msg .meta {
        font-size: 11px;
        color: #666;
        margin-top: 3px;
    }

    .composer {
        padding: 10px;
        border-top: 1px solid #e3e3e3;
        display: flex;
        gap: 8px;
        align-items: center;
        background: #fff;
    }

        .composer textarea {
            flex: 1;
            resize: none;
            height: 46px;
            padding: 8px;
        }

        .composer button {
            height: 46px;
        }

    .muted {
        color: #999;
    }

    .small {
        font-size: 12px;
    }
</style>

<div id="commApp"
     data-current-user-id="@currentUserId"
     data-api-base="@Url.Content("~/Communication")"
     data-hub-url="@Url.Content("~/hubs/chat")">

    <div class="chat-app">
        <aside class="chat-sidebar">
            <div class="header">
                <div class="title">Conversations</div>
                <div>
                    <button id="btnRefreshConvs" title="Refresh">⟳</button>
                </div>
            </div>
            <div class="tools">
                <label for="txtDirectUserId" class="small muted">Start Direct:</label>
                <input type="number" id="txtDirectUserId" class="form-control form-control-sm" placeholder="User ID" />
                <button id="btnStartDirect" class="btn btn-sm btn-primary">Start</button>
            </div>
            <div class="list" id="conversationList"></div>
        </aside>

        <main class="chat-main">
            <div class="header">
                <div class="left">
                    <div class="title" id="convTitle">Select a conversation</div>
                    <div class="presence" id="presenceArea">
                        <span class="dot offline" id="presenceDot"></span>
                        <span id="presenceText" class="muted">—</span>
                    </div>
                </div>
                <div class="conn" id="connStatus">
                    <span class="badge err">Disconnected</span>
                </div>
            </div>

            <div class="messages-pane" id="messagesPane"></div>

            <div class="composer">
                <textarea id="messageInput" placeholder="Type a message. Press Enter to send. Shift+Enter for newline."></textarea>
                <button id="btnSend" class="btn btn-primary">Send</button>
            </div>
        </main>
    </div>
</div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script src="/js/script/communication.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const root = document.getElementById('commApp');
        window.CommunicationUI.init({
            apiBase: root.dataset.apiBase || '/Communication',
            hubUrl: root.dataset.hubUrl || '/hubs/chat',
            currentUserId: parseInt(root.dataset.currentUserId || '0', 10),
            pageSize: 50,
            presencePollMs: 30000
        });
    });
</script>





